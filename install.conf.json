[
  {
    "clean": ["~", "~/.config"]
  },
  {
    "create": ["~/.config/ghostty", "~/Library/Application Support/lazygit", "~/.local/bin", "~/.claude", "~/.config/worktrunk"]
  },
  {
    "link": {
      "~/.config/nvim/init.lua": {
        "force": true,
        "path": "nvim/init.lua"
      },
      "~/.config/ghostty/config": {
        "force": true,
        "path": "ghostty/config"
      },
      "~/.wezterm.lua": {
        "force": true,
        "path": "wezterm/wezterm.lua"
      },
      "~/.local/bin/merge-to-dev.sh": {
        "force": true,
        "path": "bin/merge-to-dev.sh"
      },
      "~/.local/bin/pull-main.sh": {
        "force": true,
        "path": "bin/pull-main.sh"
      },
      "~/.local/bin/push-no-verify.sh": {
        "force": true,
        "path": "bin/push-no-verify.sh"
      },
      "~/.zshrc": {
        "force": true,
        "path": "zshrc"
      },
      "~/Library/Application Support/lazygit/config.yml": {
        "force": true,
        "path": "lazygit/config.yml"
      },
      "~/.local/bin/claude-notify": {
        "force": true,
        "path": "bin/claude-notify"
      },
      "~/.claude/settings.json": {
        "force": true,
        "path": "claude/settings.json"
      },
      "~/.config/worktrunk/config.toml": {
        "force": true,
        "path": "worktrunk/config.toml"
      }
    }
  }
]
